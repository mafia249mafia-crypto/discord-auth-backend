# This file contains sensitive environment variables for the Discord Bot and OAuth2 setup.
# You MUST rename this file to ".env" and fill in the actual values.
# DO NOT commit your actual .env file to version control.

# --- Discord Application (OAuth2) Credentials ---
# Go to Discord Developer Portal -> Applications -> Your Application -> OAuth2 -> General
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# The Redirect URI MUST EXACTLY match one of the redirect URIs you have configured
# in your Discord Application settings (OAuth2 -> General -> Redirects).
# For local development, this is typically http://127.0.0.1:5000/callback
DISCORD_REDIRECT_URI="http://127.0.0.1:5000/callback"

# --- Allowed Discord User IDs ---
# A comma-separated list of Discord User IDs that are allowed to access the protected page.
# To get a user's Discord ID: Enable Developer Mode in Discord (User Settings -> Advanced -> Developer Mode),
# then right-click on a user's name/profile -> Copy ID.
# Example: "123456789012345678,987654321098765432"
ALLOWED_DISCORD_USER_IDS="YOUR_ALLOWED_DISCORD_USER_IDS_HERE"

# --- Frontend URL ---
# This is the URL where your frontend (index.html) is served.
# The backend will redirect to this URL after successful or failed verification.
# For local development, if you are using Live Server, it might be http://127.0.0.1:5500/index.html
FRONTEND_URL="http://127.0.0.1:5500/index.html"
